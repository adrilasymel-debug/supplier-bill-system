# Copy this file to .streamlit/secrets.toml for local dev
# (that file is gitignored - never commit real secrets).
#
# On Streamlit Community Cloud, paste these same keys/values into:
# App settings -> Secrets  (instead of using this file).

# --- Supabase Postgres (Project Settings -> Database -> Connection info) ---
SUPABASE_DB_HOST = "db.xxxxxxxxxxxx.supabase.co"
SUPABASE_DB_PORT = 5432
SUPABASE_DB_NAME = "postgres"
SUPABASE_DB_USER = "postgres"
SUPABASE_DB_PASSWORD = "your-database-password"

# --- Supabase Storage (Project Settings -> API) ---
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
# Use the "service_role" secret key (not the anon/public key) so
# uploads from the app work regardless of storage row-level-security.
SUPABASE_SERVICE_KEY = "your-service-role-key"

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY = "your-gemini-api-key"
